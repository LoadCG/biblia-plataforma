  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm test && npm run check:a11y && npm run check:e2e && npm run check:ui && npm run check:editorial && npm run check:revisao-editorial && npm run check:planos-editoriais && npx expo-doctor",
    "export:web": "expo export --platform web",
    "check:content": "npm run gerar-conteudo && git diff --exit-code -- core/content/dados/livros.json",
    "check:a11y": "node scripts/verificar-acessibilidade.js",
    "check:e2e": "node scripts/verificar-maestro.js",
    "check:ui": "node scripts/verificar-ui-responsiva.js",
    "check:copy-ui": "node scripts/verificar-copy-interface.js",
    "check:static": "node scripts/verificar-export-estatico.js",
    "check:editorial": "node scripts/relatorio-cobertura-editorial.js",
    "check:revisao-editorial": "node scripts/verificar-revisao-editorial.js",
    "check:piloto-editorial": "node scripts/verificar-piloto-editorial.js",
    "check:planos-editoriais": "node scripts/verificar-planos-editoriais.js",
    "relatorio:editorial": "node scripts/relatorio-cobertura-editorial.js",
    "gerar-conteudo": "node scripts/gerar-conteudo.js"
